# Harness path bridges — absolute symlinks recreated by install.sh, machine-local
/CLAUDE.md
/.claude/skills
/.claude/agents

# Runtime artifacts from background processes (brain HTTP server, brain watcher).
# These are local-process state, not source — pid + log rotate per-machine.
/run_state/brain-*.log
/run_state/brain-*.pid

# Python bytecode caches — never canonical.
__pycache__/
*.pyc

# Dev-only test runner (brain server tests). Machine-local.
/.venv/
/.pytest_cache/

# Dynamic brain proposal-review: LLM-generated artifacts, regenerated lazily by
# scripts/brain_server.py. Runtime-current, not git-canonical (P-013 territory).
# The proposal card store + auto-generated dev-agent handoffs (P-NNN.md); the
# dated handoffs/<date>-*.md stay tracked.
/memory/brain/proposal_cards.jsonl
/memory/brain/proposals.jsonl.lock
/handoffs/P-*.md

# Generated brain VIEW PROJECTIONS — deterministic build artifacts rebuilt from the
# canonical ledgers by scripts/regen_brain.sh (and watch_brain.py). NOT source; this
# is the P-013 resolution (DECISIONS 2026-06-15). Canonical sources stay tracked:
# the ledgers, the projector scripts, and the hand-written view assets (*.html,
# map.js, ui.js, tokens.css, mockups/). The .gitkeep files keep the dirs.
/memory/brain/pages/*.md
/memory/brain/view/map_data.js
/memory/brain/view/summary.json
/memory/brain/view/summary_data.js
/memory/brain/view/index.json
/memory/brain/view/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md
