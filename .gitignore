# Harness path bridges — absolute symlinks recreated by install.sh, machine-local
/CLAUDE.md
/.claude/skills
/.claude/agents

# Runtime artifacts from background processes (brain HTTP server, brain watcher).
# These are local-process state, not source — pid + log rotate per-machine.
/run_state/brain-*.log
/run_state/brain-*.pid

# Python bytecode caches — never canonical.
__pycache__/
*.pyc

# Dev-only test runner (brain server tests). Machine-local.
/.venv/
/.pytest_cache/

# Dynamic brain proposal-review: LLM-generated artifacts, regenerated lazily by
# scripts/brain_server.py. Runtime-current, not git-canonical (P-013 territory).
# The proposal card store + auto-generated dev-agent handoffs (P-NNN.md); the
# dated handoffs/<date>-*.md stay tracked.
/memory/brain/proposal_cards.jsonl
/handoffs/P-*.md
